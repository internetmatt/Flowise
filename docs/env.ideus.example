# Ideus local overlay for internetmatt/IdeaFlow.
# Copy over packages/server/.env (or docker/.env) when running beside AskDilly-Core.
# Do not commit real API keys.

PORT=3010
APP_URL=http://localhost:3010

# Core canvas embed (compose :5678, host publish :15678, WT hostname).
IFRAME_ORIGINS=http://localhost:5678,http://localhost:15678,https://wt-flowise-replacement.localhost

# Core worktree then sets:
#   IDEUS_FLOWISE_BASE_URL=http://localhost:3010
#   IDEUS_FLOWISE_API_KEY=<this instance's workspace API key, server-side only>
